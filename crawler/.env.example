# Copy this file to .env (same folder) and fill in the real values there.
# .env is gitignored - never commit real keys. Uncommented vars here just document
# what's needed; leave this file itself free of real values.

# Tavily (https://tavily.com) - web search, free tier: 1000 credits/month, no card needed.
CRAWLER_TAVILY_API_KEY=

# MSHack AI gateway (https://doc.muensterhack.de/s/PRr9HvRzEk), used by QueryService
# to plan search queries. Only the key is required - base URL and model already
# default to the gateway and to the free DeepSeek-V4-Flash model.
CRAWLER_LLM_API_KEY=
# CRAWLER_LLM_BASE_URL=https://mshack.items.services/v1
# CRAWLER_LLM_MODEL=DeepSeek-V4-Flash

# Background crawl every N minutes (each cycle = 5 Tavily credits). 0 = off.
# CRAWLER_CRAWL_INTERVAL_MINUTES=30
