# Copy this file to .env (same folder) and fill in the real values there.
# .env is gitignored - never commit real keys. Uncommented vars here just document
# what's needed; leave this file itself free of real values.

# Firecrawl (https://firecrawl.dev) - web search + schema-guided extraction.
CRAWLER_FIRECRAWL_API_KEY=

# Locally hosted LLM used by QueryService to plan search queries.
CRAWLER_LLM_API_KEY=
CRAWLER_LLM_BASE_URL=
CRAWLER_LLM_MODEL=
